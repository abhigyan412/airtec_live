# Copy to .env.local for local runs. On Vercel: Project → Settings →
# Environment Variables (Production), then redeploy.

# The site's own address, used for the sitemap, robots and share previews.
NEXT_PUBLIC_SITE_URL=https://airtec.live

# Lead capture (POST /api/public/leads writes to Supabase directly).
# The anon key is the public one; it can't add or read leads by itself.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
# Add-only secret: must match marketing_lead_settings.insert_secret in the
# database (supabase migration 20261011010000_marketing_leads_site_insert.sql).
LEADS_INSERT_SECRET=

# Optional: Discord / Slack / Google Chat incoming webhook, pinged per lead.
LEADS_WEBHOOK_URL=
